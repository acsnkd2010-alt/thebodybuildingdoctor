# WordPress REST API Configuration
WORDPRESS_API_URL=https://your-wordpress-site.com
# Shared secret: Next.js sends this as Bearer token when calling WordPress (profile, likes, training-log, etc.).
# Generate: openssl rand -base64 24
# Set the SAME value in WordPress → Settings → BMC Settings → API Key
WORDPRESS_API_KEY=your-shared-secret-here

# Logo URL (shows in sidebar and header where "Media Channel" appears)
# Use full URL, e.g. https://your-wordpress.com/wp-content/uploads/logo.png
# Falls back to this if WordPress site-info does not return logo_url
NEXT_PUBLIC_LOGO_URL=

# JWT Secret for Next.js session tokens (required for login to work)
# The app creates its own JWT (using the jose library) and stores it in an HTTP-only cookie.
# You do NOT need a WordPress JWT plugin; the BMC plugin handles auth. This secret is only for the Next.js app.
# Generate a secure random string: openssl rand -base64 32
JWT_SECRET=your-secure-jwt-secret-key-here

# Node Environment
NODE_ENV=production
